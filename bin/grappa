#!/usr/bin/env bash
# bin/grappa — host-side operator dispatcher.
#
# One verb per task. Run from any worktree of the grappa repo:
#
#   bin/grappa help                     list verbs
#   bin/grappa help <verb>              per-verb help
#   bin/grappa <verb> [args]            dispatch
#
# The container IS the runtime. Boot-time verbs (create-user,
# bind-network, etc.) delegate to mix tasks inside the container via
# scripts/mix.sh (which auto-detects MIX_ENV). Live-state verbs
# (delete-visitor, reap-visitors, list-*) and remote-shell attach to
# the live BEAM via Erlang distribution: `elixir --rpc-eval grappa@grappa`
# evaluates a `Grappa.Operator.<verb>(...)` expression on the running
# node (per T-2). Operator-side bookkeeping lives in lib/grappa/operator.ex
# so the bash dispatcher stays a thin shell — one feature, one code
# path, every door.
#
# Verb name policy: kebab-case on the command line, snake_case for the
# underlying mix task (grappa.create_user, etc.). Mapping is mechanical
# (tr - _) — no per-verb hardcoding.
#
# Verb table: a single `declare -Ag VERBS` map (below) is the source
# of truth for dispatch + help. Per-verb metadata is encoded as a
# pipe-separated tuple `kind|target|group|description`:
#   - kind:    boot|rpc|attach|debug|meta
#   - target:  for boot, the mix task name; for rpc, the
#              `Grappa.Operator.fn!()` expression body (sans args);
#              for attach/debug/meta, the verb name itself (handled
#              by the per-verb function `verb_<snake>`).
#   - group:   help-banner section header
#   - description: one-line summary for help-banner
#
# Adding a new verb is now a TWO-touchpoint change: one VERBS entry +
# one verb_<snake>() function (boot verbs can drop the explicit
# function by using the default boot-handler).

set -euo pipefail

# shellcheck source=scripts/_lib.sh
. "$(dirname "$0")/../scripts/_lib.sh"

# Test seam: bats overrides SCRIPTS_DIR to point at a tmpdir with
# fake scripts/mix.sh. Production calls inherit the real scripts/.
SCRIPTS_DIR="${SCRIPTS_DIR:-$SRC_ROOT/scripts}"

# Run every `docker compose` from the MAIN repo root, like every sibling
# script. Two things break otherwise when invoked from a worktree (this
# dispatcher's docstring promises "run from any worktree"):
#   1. compose has no top-level `name:`, so the project defaults to the
#      CWD basename — from a worktree that's the worktree dir, a DIFFERENT
#      project than the live container (created under the main-repo name),
#      so `exec grappa` can't find it.
#   2. COMPOSE_ARGS carries a RELATIVE `-f compose.override.yaml` resolved
#      against CWD; the gitignored override lives only at the main repo,
#      so from a worktree docker errors "no such file".
# `cd "$REPO_ROOT"` (the main repo, resolved via git-common-dir in _lib.sh)
# fixes both. SCRIPTS_DIR is already absolute, so boot verbs are unaffected.
cd "$REPO_ROOT"

# --- verb table -----------------------------------------------------------
#
# kebab-name → kind|target|group|description
#
# Ordering inside each group section is the order verbs appear in
# `help_top()`. Across groups, ordering is preserved by the explicit
# GROUP_ORDER array below.
declare -Ag VERBS=(
    [create-user]="boot|grappa.create_user|boot|create a Grappa user account"
    [bind-network]="boot|grappa.bind_network|boot|bind a (user, network) credential"
    [add-server]="boot|grappa.add_server|boot|add a server entry to a network"
    [remove-server]="boot|grappa.remove_server|boot|remove a server entry from a network"
    [set-network-caps]="boot|grappa.set_network_caps|boot|set per-network session caps"
    [unbind-network]="boot|grappa.unbind_network|boot|remove a (user, network) credential"
    [update-network-credential]="boot|grappa.update_network_credential|boot|edit autojoin / nick / SASL fields"
    [seed-scrollback]="boot|grappa.seed_scrollback|boot|seed dev scrollback"
    [gen-encryption-key]="boot|grappa.gen_encryption_key|boot|generate a Cloak.Vault key"
    [gen-vapid]="boot|grappa.gen_vapid|boot|generate a VAPID keypair (push)"

    [delete-visitor]="rpc|Grappa.Operator.delete_visitor!|rpc|terminate + delete a visitor (sync)"
    [reset-totp]="rpc|Grappa.Operator.reset_totp!|rpc|disarm TOTP for a locked-out account"
    [reset-passkeys]="rpc|Grappa.Operator.reset_passkeys!|rpc|reset passkeys for a locked-out account"
    [reap-visitors]="rpc|Grappa.Operator.reap_visitors!|rpc|force-run the visitor reaper"
    [list-sessions]="rpc|Grappa.Operator.list_sessions_text!|rpc|inspect the live session registry"
    [list-credentials]="rpc|Grappa.Operator.list_credentials_text!|rpc|list cred bindings + state"
    [list-visitors]="rpc|Grappa.Operator.list_visitors_text!|rpc|list active visitor rows"
    [db-latency]="rpc|Grappa.Operator.db_latency_text!|rpc|#357 SQLite write/query-latency aggregate"
    [db-latency-reset]="rpc|Grappa.Operator.reset_db_latency!|rpc|zero db-latency counters (open a window)"

    [remote-shell]="attach|remote-shell|attach|iex --remsh against the live BEAM"

    [open-db]="debug|open-db|debug|interactive sqlite3 against active env (RW)"
    [shell]="debug|shell|debug|bash inside the grappa container"

    [help]="meta|help|meta|this banner / per-verb help"
)

declare -ag GROUP_ORDER=(boot rpc attach debug meta)
declare -Ag GROUP_HEADERS=(
    [boot]="Boot-time verbs (mix tasks; auto-detect MIX_ENV from container):"
    [rpc]="Live-state verbs (--rpc-eval against the live BEAM):"
    [attach]="Live-state attach:"
    [debug]="Debug verbs:"
    [meta]="Meta:"
)

# Field accessor — `verb_field <kebab> <field-index>`. Field indices:
# 1=kind, 2=target, 3=group, 4=description. Returns empty if verb is
# unknown (caller's responsibility to gate on `[ -n "${VERBS[$v]:-}" ]`).
verb_field() {
    local entry="${VERBS[$1]:-}"
    [ -z "$entry" ] && return 0
    cut -d'|' -f"$2" <<<"$entry"
}

# Kebab → snake conversion. Pure mechanical — no per-verb hardcoding.
kebab_to_snake() { tr '-' '_' <<<"$1"; }

# #1086 — true when `--help` or `-h` appears anywhere in the argument
# list. Neither layer used to claim the flag: this dispatcher knew help
# only as a VERB (`bin/grappa help <verb>`), and the boot tasks parse
# `strict:`, which drops an unrecognised switch silently and then dies on
# the first required option with a raw KeyError traceback. Worse, the
# rpc and debug verbs took the flag for a positional argument — a live
# `delete-visitor --help` used to RPC `delete_visitor!("--help")` at the
# running BEAM. Claiming it here is one rule for all verbs, including the
# ones that never reach a mix task.
#
# Scanned anywhere rather than in first position only, because
# `bin/grappa bind-network --user vjt --help` is how an operator asks
# once they are already mid-command. The cost is that an option VALUE
# spelled exactly `--help` reads as a help request; no switch on any
# verb takes a value that could plausibly be spelled that way.
wants_help() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            -h | --help) return 0 ;;
        esac
    done
    return 1
}

# --- helpers --------------------------------------------------------------

mix_task() {
    # Auto-detect MIX_ENV from the live container; scripts/mix.sh handles
    # the override flag if the operator wants explicit env. Boot-time
    # verbs typically run against the container the operator is deploying
    # against, so auto-detect is the right default.
    exec "$SCRIPTS_DIR/mix.sh" "$@"
}

# Run a Grappa.Operator expression on the live BEAM via Erlang dist.
# Same shape as `remote-shell --batch -e <expr>` — mirror T-2 exactly so
# the operator-verb surface and the introspection surface share one
# transport. The expression is evaluated on the REMOTE node (`--rpc-eval`),
# NOT on the client (`--remsh -e` would evaluate client-side, defeating
# the point of attaching to the live tree).
rpc_eval() {
    local expr=$1
    exec docker compose "${COMPOSE_ARGS[@]}" exec -T grappa sh -c \
        'exec elixir --sname "admin-$$" --cookie "$RELEASE_COOKIE" --rpc-eval grappa@grappa "$1"' \
        -- "$expr"
}

die_unknown_verb() {
    printf 'bin/grappa: unknown verb %q\n' "$1" >&2
    # shellcheck disable=SC2016  # backticks are literal prose in the message
    printf 'Run `bin/grappa help` for the full verb table.\n' >&2
    exit 64
}

# --- per-verb implementations --------------------------------------------
#
# Boot verbs use the generic `dispatch_boot` handler (kebab → mix task
# name from the VERBS table). RPC verbs that take a positional argument
# need a bespoke `verb_<snake>` function; nullary RPC verbs route
# through the generic `dispatch_rpc` handler.

dispatch_boot() {
    local verb=$1; shift
    local task
    task="$(verb_field "$verb" 2)"
    mix_task "$task" "$@"
}

dispatch_rpc() {
    local verb=$1; shift
    if [ $# -ne 0 ]; then
        printf 'bin/grappa: %s takes no arguments\n' "$verb" >&2
        exit 64
    fi
    local fn
    fn="$(verb_field "$verb" 2)"
    rpc_eval "${fn}()"
}

verb_delete_visitor() {
    if [ $# -ne 1 ]; then
        printf 'Usage: bin/grappa delete-visitor <uuid>\n' >&2
        exit 64
    fi
    local id=$1
    rpc_eval "Grappa.Operator.delete_visitor!(\"$id\")"
}

# The two account-recovery verbs. They were mix tasks; a mix task runs in a
# SECOND BEAM, so its in-node effects never reach the node serving traffic —
# wrong lane for a recovery verb. Arg-taking, hence bespoke, not dispatch_rpc.
verb_reset_totp() {
    if [ $# -ne 1 ]; then
        printf 'Usage: bin/grappa reset-totp <account-name>\n' >&2
        exit 64
    fi
    rpc_eval "Grappa.Operator.reset_totp!(\"$1\")"
}

verb_reset_passkeys() {
    if [ $# -ne 1 ]; then
        printf 'Usage: bin/grappa reset-passkeys <account-name>\n' >&2
        exit 64
    fi
    rpc_eval "Grappa.Operator.reset_passkeys!(\"$1\")"
}

verb_remote_shell() {
    # T-A2 / T-2: live-BEAM attach via Erlang distribution. Cookie is
    # sourced INSIDE the container's `sh -c` (no host needs to know it);
    # admin sname uses $$ for per-invocation uniqueness.
    #
    # Interactive uses `iex --remsh` (REPL attaches to the live node).
    # Batch uses `elixir --rpc-eval`: `iex --remsh -e "<expr>"` evaluates
    # the expression in the CLIENT node before attaching, defeating the
    # operator's intent (Process.list() returns 60-ish vergine procs
    # rather than the live tree's 140+). `--rpc-eval` evaluates on the
    # REMOTE node and prints the result, no shell attached.
    case "${1:-}" in
        --batch)
            shift
            if [ "${1:-}" != "-e" ] || [ -z "${2:-}" ]; then
                # shellcheck disable=SC2016  # backticks are literal prose
                printf 'remote-shell --batch requires `-e <expr>`.\n' >&2
                printf 'Usage: bin/grappa remote-shell --batch -e <expr>\n' >&2
                exit 64
            fi
            rpc_eval "$2"
            ;;
        "")
            exec docker compose "${COMPOSE_ARGS[@]}" exec grappa sh -c \
                'exec iex --sname "admin-$$" --cookie "$RELEASE_COOKIE" --remsh grappa@grappa'
            ;;
        *)
            printf 'remote-shell: unknown arg %q\n' "$1" >&2
            printf 'Usage: bin/grappa remote-shell [--batch -e <expr>]\n' >&2
            exit 64
            ;;
    esac
}

verb_open_db() {
    # WARNING: opens RW. scripts/db.sh is the ambient-safe RO alternative
    # for casual prod queries. Auto-detects active env's DB file via the
    # shared _lib.sh probe (single source of truth with scripts/mix.sh).
    local env db
    env="$(detect_mix_env)"
    env="${env:-dev}"
    db="/app/runtime/grappa_${env}.db"
    exec docker compose "${COMPOSE_ARGS[@]}" exec grappa sqlite3 "$db" "$@"
}

verb_shell() {
    exec docker compose "${COMPOSE_ARGS[@]}" exec grappa bash
}

# --- per-verb help -------------------------------------------------------
#
# EVERY verb has an inline `verb_help_<snake>` heredoc — one rule, no
# per-kind branch in `dispatch_help`.
#
# #1086 second slice: the ten boot verbs used to delegate to
# `scripts/mix.sh --env=dev help grappa.<task>`, letting mix print the
# task's @shortdoc/@moduledoc. Two reasons that went away:
#
#   1. It answered a DIFFERENT question. The moduledoc documents the mix
#      task — it spells the command `scripts/mix.sh grappa.create_user`,
#      not `bin/grappa create-user`, and carries developer prose (Boundary
#      declarations, the #251/#266 vhost-precedence history) that an
#      operator asking "what flags does this take" did not ask for.
#   2. It cost a container. With no live grappa container, scripts/mix.sh
#      falls through _lib.sh's `in_container_or_oneshot` to
#      `docker compose run --rm --no-deps` — booting an image to print a
#      paragraph, and failing outright where docker is unavailable.
#
# The duplication this creates against @shortdoc/@moduledoc is DELIBERATE
# and bounded: the prose is written for a different reader, but the FLAG
# TABLE is the same contract twice, so it is gated. Every boot verb's
# flag lines must name exactly the task's `@switches`, both directions —
# see test/mix/tasks/grappa/operator_help_drift_test.exs. Generating the
# whole block from the moduledoc was rejected: see the test's moduledoc
# for why the `wireTypes.ts` codegen precedent does not transfer.
#
# FORMAT CONTRACT for the boot blocks: a flag DECLARATION sits at 8+
# columns with `--flag` as its first token; prose sits at 4. The gate
# reads the former and ignores the latter, so a prose sentence that wraps
# onto a `--flag` does not register as a switch. Keep prose off column 8.

verb_help_create_user() { cat <<'EOF'
create-user --name <name> --password <secret> [--admin]
    Create a Grappa user account. The password is hashed with Argon2
    before insertion; the new user's id is printed on success.

    Required:
        --name <name>          account name
        --password <secret>    plaintext, hashed on the way in
    Optional:
        --admin                grant is_admin at creation - the
                               one-command first-admin bootstrap
EOF
}

verb_help_bind_network() { cat <<'EOF'
bind-network --user <name> --network <slug> --server <host:port>
             --nick <nick> --auth <mode> [options]
    Idempotently create the network, one server entry and the
    per-(user, network) credential in a single call. Rebinding an
    existing credential is a changeset error - use
    update-network-credential to mutate one. Adding a server that is
    already there is a silent no-op.

    TLS posture is port-sniffed when neither --tls nor --no-tls is
    given: 6697 means on, any other port means off.

    Required:
        --user <name>          Grappa account that owns the binding
        --network <slug>       network slug (created when absent)
        --server <host:port>   upstream endpoint
        --nick <nick>          nick to use upstream
        --auth <mode>          auto | sasl | server_pass |
                               nickserv_identify | none
    Optional:
        --tls / --no-tls       force the TLS posture (default: sniffed)
        --password <secret>    NickServ / server password
        --autojoin <list>      comma-separated channel list
        --realname <text>      IRC realname field
        --sasl-user <name>     SASL account when it differs from the nick
        --services-flavor <f>  services suite running on the network
        --source <ip>          pin the outbound source address. Literal
                               IPv4/IPv6 only, no hostname, no CIDR. It
                               WINS over a subject's vhost selection and
                               the rotation pool (#266).
EOF
}

verb_help_add_server() { cat <<'EOF'
add-server --network <slug> --server <host:port> [options]
    Append another endpoint to an existing network's fail-over list.
    The network must already exist - this verb never creates one.
    Re-adding the same (network, host, port) is a no-op.

    TLS posture is port-sniffed when neither --tls nor --no-tls is
    given: 6697 means on, any other port means off. The old
    always-on default was a footgun: a plain :6667 leaf added without
    an explicit flag produces a handshake that never completes, and
    the failure surfaces as :connect_timeout ~8s into every spawn.

    Required:
        --network <slug>       network the endpoint belongs to
        --server <host:port>   endpoint to add
    Optional:
        --tls / --no-tls       force the TLS posture (default: sniffed)
        --no-tls-verify        do NOT validate this server's certificate
                               chain (#1677). Default is to validate, and
                               it is never sniffed from the port. Only for
                               networks whose leaves can never present a
                               valid chain (EFNet, IRCnet): cleartext is
                               WORSE, since it leaks the whole stream,
                               SASL included. If the network has a CA,
                               install it in the system trust store
                               instead. Every such session logs a warning.
        --priority <n>         fail-over order, lower first (default 0)
        --source <ip>          pin the outbound source address. Literal
                               IPv4/IPv6 only, no hostname, no CIDR.
EOF
}

verb_help_remove_server() { cat <<'EOF'
remove-server --network <slug> --server <host:port>
    Remove one (host, port) endpoint. The network row and its other
    servers stay in place - use unbind-network to drop a binding.
    Idempotent: removing an already-gone endpoint exits 0.

    Required:
        --network <slug>       network the endpoint belongs to
        --server <host:port>   endpoint to remove
EOF
}

verb_help_set_network_caps() { cat <<'EOF'
set-network-caps --network <slug> <cap flag...>
    Set or clear the admission caps on a network row. Pass only the
    caps you want to change; the others keep their current value.
    Setting a cap and clearing the same cap are mutually exclusive.

    A cap of 0 is a degenerate lock-down (admit none); a cleared cap
    is NULL, meaning unlimited.

    Required:
        --network <slug>       network to update
    At least one of:
        --max-visitor-sessions <n>     cap concurrent visitor sessions
        --max-user-sessions <n>        cap concurrent user sessions
        --max-per-ip <n>               cap concurrent sessions per IP
        --clear-max-visitor-sessions   drop the visitor cap
        --clear-max-user-sessions      drop the user cap
        --clear-max-per-ip             drop the per-IP cap
EOF
}

verb_help_unbind_network() { cat <<'EOF'
unbind-network --user <name> --network <slug>
    Remove the per-(user, network) credential and stop the live
    session. The network row is never deleted, even when its last
    binding goes away. Idempotent: unbinding nothing exits 0.

    Required:
        --user <name>          account that owns the binding
        --network <slug>       network to unbind from
EOF
}

verb_help_update_network_credential() { cat <<'EOF'
update-network-credential --user <name> --network <slug> [options]
    Mutate an existing credential. Pass only the fields you want to
    change - every other field keeps its current value. Use
    bind-network to create a binding; this verb only updates.

    Required:
        --user <name>          account that owns the binding
        --network <slug>       network the credential belongs to
    Optional:
        --nick <nick>          nick to use upstream
        --password <secret>    NickServ / server password
        --auth <mode>          auto | sasl | server_pass |
                               nickserv_identify | none
        --autojoin <list>      REPLACES the channel list (comma-
                               separated); omit it to keep the
                               current one
        --realname <text>      IRC realname field
        --sasl-user <name>     SASL account when it differs from the nick
EOF
}

verb_help_seed_scrollback() { cat <<'EOF'
seed-scrollback --user <name> --network <slug> --channel <#chan>
                --count <n> --sender <nick>
    e2e fixture verb, NOT a production one: persist N synthetic
    :privmsg rows so a scrollback spec gets a deterministically tall
    pane without driving an IRC peer through bahamut-test, whose
    fakelag throttle makes seeds over ~5 messages non-deterministic.

    Each row's server_time increases monotonically from
    now - count * 100ms, so the rows sort naturally and span a
    timeline a test can place a read cursor inside.

    Required:
        --user <name>          account that owns the scrollback
        --network <slug>       network slug
        --channel <#chan>      channel to seed
        --count <n>            row count; over 2000 is refused
        --sender <nick>        synthetic peer nick on every row
EOF
}

verb_help_gen_encryption_key() { cat <<'EOF'
gen-encryption-key
    Print a fresh base64-encoded 32-byte key for Grappa.Vault (Cloak
    AES-GCM). Save it as GRAPPA_ENCRYPTION_KEY in your .env and back
    it up separately: losing the key means losing the ability to
    decrypt every stored upstream credential.

    Run once per deployment, at first install. Rotating later needs a
    re-encryption migration, which does not exist yet.

    Takes no flags.
EOF
}

verb_help_gen_vapid() { cat <<'EOF'
gen-vapid
    Print a fresh ECDSA P-256 VAPID keypair (RFC 8292) for Web Push
    signing, as env lines ready to paste into the grappa service's
    environment: block:

        VAPID_PUBLIC_KEY=BJk...
        VAPID_PRIVATE_KEY=z3p...
        VAPID_SUBJECT=mailto:you@example.org   (optional)

    Run once per deployment, at first install. Rotating the keypair
    invalidates every push_subscriptions row - browsers reject pushes
    signed by an unknown application server key - so expect users to
    re-toggle push in cic settings afterwards.

    Takes no flags.
EOF
}

verb_help_delete_visitor() { cat <<'EOF'
delete-visitor <uuid>
    Synchronously terminate the visitor's Session.Server and delete
    the DB row, freeing the SessionRegistry cap slot in the same call.
    CASCADE wipes visitor_channels, messages, accounts_sessions,
    query_windows, push_subscriptions, user_settings, read_cursors.

    Unknown uuid: raises Ecto.NoResultsError; bin/grappa exits non-zero.
EOF
}

verb_help_reset_totp() { cat <<'EOF'
reset-totp <account-name>
    Clear the account's TOTP secret and revoke every live bearer,
    restoring password-only login. The undo for an enrolment the
    account owner did not make.

    Recovery codes are shared with the passkey factor: they go only
    if this leaves nothing armed to redeem them.

    Runs on the LIVE node, which is load-bearing — the revocation
    also tears down the account's open WebSockets. The former
    `mix grappa.reset_totp` ran in a separate BEAM, the wrong lane
    for a verb whose in-node effects have to take.

    Unknown account: raises; bin/grappa exits non-zero.
EOF
}

verb_help_reset_passkeys() { cat <<'EOF'
reset-passkeys <account-name>
    Remove every passkey, restore password login and revoke every
    live bearer. Does NOT disarm TOTP — an account with TOTP armed
    returns to password plus TOTP.

    Same live-node rationale as reset-totp.

    Unknown account: raises; bin/grappa exits non-zero.
EOF
}

verb_help_reap_visitors() { cat <<'EOF'
reap-visitors
    Force-run Grappa.Visitors.Reaper.sweep/0 on demand. The scheduled
    tick runs every 60s; this verb is the operator-on-demand variant.
EOF
}

verb_help_list_sessions() { cat <<'EOF'
list-sessions
    Print every live Session.Server in Grappa.SessionRegistry as a
    tab-separated table. Columns:
        subject_kind  subject_id  network_id  nick  pid  alive  mailbox_len  memory_kb
    The mailbox_len + memory_kb columns surface bloat / leaks on a
    stuck session. nick is the LIVE nick upstream answers to, which is
    not always the configured one: compare it against list-credentials
    to spot a session stranded on <nick>_ by a failed ghost recovery.
EOF
}

verb_help_list_credentials() { cat <<'EOF'
list-credentials
    Print every bound (user, network) credential as a tab-separated
    table. Columns:
        user_id  network_slug  nick  state  connection_state_reason
EOF
}

verb_help_list_visitors() { cat <<'EOF'
list-visitors
    Print every active visitor as a tab-separated table. Columns:
        id  nick  network_slug  expires_at  identified  inserted_at
    Active = identified (never expires) OR anon with expires_at > now.
EOF
}

verb_help_db_latency() { cat <<'EOF'
db-latency
    Print the #357 SQLite write-latency / repo query-latency
    aggregate as tab-separated tables. Same Grappa.DbLatency snapshot
    the admin GET /admin/db_latency returns - one feature, one code
    path, every door.

    Counters are cumulative since the last reset, so the reading is
    only as meaningful as the window: run db-latency-reset, wait out
    the sample window (~25s under load), then read.
EOF
}

verb_help_db_latency_reset() { cat <<'EOF'
db-latency-reset
    Zero the Grappa.DbLatency counters, opening a fresh sample window
    for db-latency. Nothing else is affected.
EOF
}

verb_help_remote_shell() { cat <<'EOF'
remote-shell [--batch -e <expr>]
    Attach to the live BEAM via Erlang distribution.

    Interactive (default — `iex --remsh`):
        bin/grappa remote-shell

    Batch (`elixir --rpc-eval`; eval one expression on the REMOTE
    node and exit):
        bin/grappa remote-shell --batch -e 'Process.list() |> length()'

    Note: `iex --remsh -e <expr>` evaluates in the CLIENT node
    BEFORE attaching the shell, which defeats `Process.list()` /
    `:sys.get_state(...)` / etc. — the point of remote-shell is to
    introspect the LIVE supervisor tree. `--rpc-eval` runs on the
    remote and prints the result.

    Distribution is internal to the container's network namespace —
    no host port is exposed. RELEASE_COOKIE is sourced from the
    container's environment (see compose.yaml + .env.example) and
    gates `iex --remsh` access. Anyone with `docker exec` privilege
    on the host can already read the cookie via `printenv`, AND any
    container attached to the `grappa_internal` bridge with Erlang
    installed could connect if it knew the cookie. The cookie is a
    same-host operator gate (sname-collision-prevention + "you
    meant to do this") rather than a network boundary.
EOF
}

verb_help_open_db() { cat <<'EOF'
open-db [sqlite3 args...]
    Open an interactive sqlite3 shell against the active env's DB
    inside the container. Detects MIX_ENV from the running container.

    WARNING: RW. Use scripts/db.sh for ambient-safe RO access.
EOF
}

verb_help_shell() { cat <<'EOF'
shell
    Drop into a bash shell inside the running grappa container.
    Requires the container to be up.
EOF
}

verb_help_help() { cat <<'EOF'
help [verb]
    With no arg, print the verb table grouped by category.
    With a verb, print that verb's help text.
EOF
}

# --- top-level help banner -----------------------------------------------
#
# Generated from the VERBS table — no manual list to keep in lockstep
# with the dispatch table.

help_top() {
    printf 'bin/grappa — host-side operator dispatcher\n\n'
    printf 'Usage:\n'
    printf '    bin/grappa <verb> [args...]\n'
    printf '    bin/grappa help [verb]\n\n'

    local group verb g desc
    for group in "${GROUP_ORDER[@]}"; do
        printf '%s\n' "${GROUP_HEADERS[$group]}"
        # Iterate in insertion order via the GROUP_ORDER+VERBS pairing.
        # Bash 4 associative arrays don't preserve insertion order on
        # iteration, so we walk a manually-ordered display list per group.
        for verb in "${VERB_DISPLAY_ORDER[@]}"; do
            g="$(verb_field "$verb" 3)"
            [ "$g" = "$group" ] || continue
            desc="$(verb_field "$verb" 4)"
            printf '    %-28s %s\n' "$verb" "$desc"
        done
        printf '\n'
    done
}

# Display order — matches the original help_top()'s curated ordering
# per group. Bash 4 associative-array iteration is unordered, so we
# carry an explicit ordered list. New verbs: add to VERBS map AND
# here in the appropriate group's position.
declare -ag VERB_DISPLAY_ORDER=(
    create-user
    bind-network
    add-server
    remove-server
    set-network-caps
    unbind-network
    update-network-credential
    seed-scrollback
    gen-encryption-key
    gen-vapid
    delete-visitor
    reset-totp
    reset-passkeys
    reap-visitors
    list-sessions
    list-credentials
    list-visitors
    db-latency
    db-latency-reset
    remote-shell
    open-db
    shell
    help
)

# --- dispatch ------------------------------------------------------------

# Per-verb help dispatch. EVERY verb, whatever its kind, has an explicit
# `verb_help_<snake>` function — so this routes by name alone, with no
# per-kind branch. A verb added to the VERBS table without one dies with
# `command not found` rather than printing nothing; the bats suite walks
# the whole table asserting help exits 0.
dispatch_help() {
    if [ $# -eq 0 ]; then
        help_top
        exit 0
    fi
    local verb=$1
    [ -n "${VERBS[$verb]:-}" ] || die_unknown_verb "$verb"
    local snake
    snake="$(kebab_to_snake "$verb")"
    "verb_help_${snake}"
}

# Main verb dispatch. Routes by `kind`:
#   - boot   → dispatch_boot (mix task)
#   - rpc    → dispatch_rpc OR bespoke verb_<snake> for arg-taking verbs
#   - meta   → help (special-cased)
#   - attach → verb_remote_shell
#   - debug  → verb_open_db / verb_shell
dispatch() {
    if [ $# -eq 0 ]; then
        help_top
        exit 0
    fi
    # #1086 — the flag form of help, routed to the SAME per-verb path the
    # verb form uses. A bare `--help` with no verb is the top banner;
    # anything else is the first argument's help. `dispatch_help` gates
    # the verb, so an unknown one still exits 64.
    if wants_help "$@"; then
        case "$1" in
            -h | --help) help_top ;;
            *) dispatch_help "$1" ;;
        esac
        exit 0
    fi
    local verb=$1
    shift
    [ -n "${VERBS[$verb]:-}" ] || die_unknown_verb "$verb"
    local kind snake
    kind="$(verb_field "$verb" 1)"
    snake="$(kebab_to_snake "$verb")"
    # Prefer a bespoke `verb_<snake>` function when one exists — that
    # handles arg-taking verbs (delete-visitor, remote-shell) and the
    # debug verbs (open-db, shell). Generic dispatchers handle the
    # nullary/conventional cases. The prefer-bespoke rule means adding
    # a future arg-taking RPC verb is one VERBS entry + one
    # verb_<snake>() function — no dispatch-table edit needed.
    if declare -F "verb_${snake}" >/dev/null; then
        "verb_${snake}" "$@"
        return
    fi
    case "$kind" in
        boot) dispatch_boot "$verb" "$@" ;;
        rpc)  dispatch_rpc  "$verb" "$@" ;;
        meta) dispatch_help "$@" ;;
        *)    die_unknown_verb "$verb" ;;
    esac
}

dispatch "$@"
